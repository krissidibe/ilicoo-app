# Copy to `.env` and adjust. Variables prefixed with EXPO_PUBLIC_ are embedded at build / bundling time.
# Restart Expo after changing them (`npx expo start -c` if values look stale).

# Base URL of the Next.js API (no trailing slash). Used for `/api/v1/...` calls.
# Production (serveur actuel : HTTP sur le port 80 uniquement ; HTTPS/443 refusé → utiliser http://).
EXPO_PUBLIC_API_BASE_URL=http://195.110.34.95

# Better Auth: même URL publique que `BETTER_AUTH_URL` côté Next.js.
EXPO_PUBLIC_BETTER_AUTH_URL=http://195.110.34.95

# Optional: other keys (see app config / hooks)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
